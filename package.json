{
  "name": "prompter",
  "version": "1.0.0",
  "description": "AI-powered interview and prompt workflow platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "vercel-build": "echo 'Build step completed'",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.1.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google-cloud/storage": "^7.16.0",
    "@qdrant/js-client-rest": "1.13.0",
    "@sendgrid/mail": "^8.1.5",
    "better-queue": "^3.8.12",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exa-js": "^1.0.12",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^11.11.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^118.0.0",
    "mammoth": "^1.6.0",
    "mem0ai": "^2.1.26",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^5.28.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.1",
    "postmark": "^4.0.5",
    "socket.io": "^4.7.2",
    "stripe": "^14.25.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "ai",
    "interview",
    "voice",
    "readiness",
    "prompts"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
